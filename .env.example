# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=media_search
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# FastAPI
SECRET_KEY=your-super-secret-key-change-it
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin_password

# Media settings
MEDIA_DIR=/app/media
UPLOAD_DIR=/app/media/uploads
PROCESSED_DIR=/app/media/processed
MAX_VIDEO_LENGTH_SECONDS=10

# Google Gemini API
GOOGLE_SERVICE_ACCOUNT_KEY=/app/service_account_key.json
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta2/models/gemini:generateText

# Admin user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_password
ADMIN_USERNAME=admin

# App settings
APP_NAME="Media Search Platform"
DEBUG=True
