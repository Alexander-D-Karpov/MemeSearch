# ---------- public ----------
PUBLIC_URL=https://ms.akarpov.ru
WEB_PORT=8080
COOKIE_SECURE=true

# ---------- storage ----------
# Host path mounted into containers at /media. Point it to the external drive.
# nginx serves /media/originals and /media/thumbs from this directory directly.
MEDIA_HOST_DIR=/mnt/memes
UPLOAD_DIR=/media
MEDIA_URL=/media
# Let the Go app serve /media itself (only for local dev without nginx)
SERVE_MEDIA=false
MAX_FILE_MB=512
MAX_ZIP_GB=100

# ---------- postgres / redis ----------
POSTGRES_USER=memesearch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=memesearch
DATABASE_URL=postgres://memesearch:change-me@postgres:5432/memesearch?sslmode=disable
REDIS_URL=redis://redis:6379/0

# ---------- admin ----------
ADMIN_USERNAME=admin
# Prefer a bcrypt hash: docker compose run --rm --no-deps web hash-password 'your-password'
# Keep the hash in single quotes so compose does not expand the $ signs
ADMIN_PASSWORD_HASH=''
ADMIN_PASSWORD=
# Optional bearer token for scripts: Authorization: Bearer <token>
ADMIN_API_TOKEN=

# Shared secret between web and the ML service (openssl rand -hex 32)
INTERNAL_TOKEN=change-me-too
ML_URL=http://ml:8001
WEB_URL=http://web:8080

# ---------- worker ----------
WORKER_CONCURRENCY=4
MAX_ATTEMPTS=3

# ---------- codex (ChatGPT subscription) ----------
# Sessions are added and logged in from /admin/codex.
CODEX_MODEL=
CODEX_REASONING_EFFORT=low
CODEX_CONCURRENCY=2
CODEX_PER_SESSION=2
CODEX_TIMEOUT_SECONDS=300
CODEX_DEFAULT_COOLDOWN_MINUTES=30
CODEX_HTTP_PROXY=
CODEX_HTTPS_PROXY=
CODEX_ALL_PROXY=

# ---------- fallback: any OpenAI-compatible vision API ----------
# OpenAI: https://api.openai.com/v1   OpenRouter: https://openrouter.ai/api/v1   Ollama: http://host:11434/v1
FALLBACK_BASE_URL=https://api.openai.com/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=gpt-4.1-mini
FALLBACK_CONCURRENCY=4

# ---------- local models (CPU) ----------
# Changing CLIP_MODEL/TEXT_MODEL to ones with other dimensions needs a DB migration.
CLIP_MODEL=google/siglip2-base-patch16-256
TEXT_MODEL=intfloat/multilingual-e5-small
CLIP_DIM=768
TEXT_DIM=384
EMBED_THREADS=4
# Empty disables speech transcription
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=4
MAX_VIDEO_FRAMES=8
MAX_GIF_FRAMES=6

# ---------- telegram bot ----------
TELEGRAM_BOT_TOKEN=
# Comma separated Telegram user ids allowed to add memes (send /start to the bot to see yours)
TELEGRAM_ADMIN_IDS=
TELEGRAM_PROXY=
# Optional self-hosted Bot API server (lifts the 20 MB download limit)
TELEGRAM_API_URL=
TELEGRAM_API_LOCAL=false
BOT_MAX_FILE_MB=20
