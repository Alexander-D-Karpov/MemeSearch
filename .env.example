# ---------- public ----------
PUBLIC_URL=https://ms.akarpov.ru
WEB_PORT=8080
COOKIE_SECURE=true

# ---------- storage ----------
# Host path mounted into containers at /media. Point it to the external drive.
# nginx serves /media/originals and /media/thumbs from this directory directly.
MEDIA_HOST_DIR=/mnt/memes
UPLOAD_DIR=/media
MEDIA_URL=/media
# Let the Go app serve /media itself (only for local dev without nginx)
SERVE_MEDIA=false
MAX_FILE_MB=512
MAX_ZIP_GB=100

# ---------- postgres / redis ----------
POSTGRES_USER=memesearch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=memesearch
DATABASE_URL=postgres://memesearch:change-me@postgres:5432/memesearch?sslmode=disable
REDIS_URL=redis://redis:6379/0

# ---------- admin ----------
ADMIN_USERNAME=admin
# Prefer a bcrypt hash: docker compose run --rm --no-deps web hash-password 'your-password'
# Keep the hash in single quotes so compose does not expand the $ signs
ADMIN_PASSWORD_HASH=''
ADMIN_PASSWORD=
# Optional bearer token for scripts: Authorization: Bearer <token>
ADMIN_API_TOKEN=

# Shared secret between web and the ML service (openssl rand -hex 32)
INTERNAL_TOKEN=change-me-too
ML_URL=http://ml:8001
WEB_URL=http://web:8080

# ---------- worker ----------
WORKER_CONCURRENCY=4
MAX_ATTEMPTS=3

# ---------- outbound proxy for OpenAI ----------
# OpenAI answers 403 from blocked regions (device login, Codex, fallback API).
# Point this at a proxy outside the blocked region: http://user:pass@host:port or socks5://user:pass@host:port
OPENAI_PROXY=

# ---------- codex (ChatGPT subscription) ----------
# Sessions are added and logged in from /admin/codex.
CODEX_MODEL=
CODEX_REASONING_EFFORT=low
# Pause a session once its 5-hour or weekly usage reaches this percent (resumes at the reset)
CODEX_MAX_USAGE_PERCENT=100
# How often idle sessions refresh their usage, minutes
CODEX_USAGE_REFRESH_MINUTES=15
CODEX_CONCURRENCY=2
CODEX_PER_SESSION=2
CODEX_TIMEOUT_SECONDS=300
CODEX_DEFAULT_COOLDOWN_MINUTES=30
CODEX_HTTP_PROXY=
CODEX_HTTPS_PROXY=
CODEX_ALL_PROXY=

# ---------- fallback: any OpenAI-compatible vision API ----------
# OpenAI: https://api.openai.com/v1   OpenRouter: https://openrouter.ai/api/v1   Ollama: http://host:11434/v1
FALLBACK_BASE_URL=https://api.openai.com/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=gpt-4.1-mini
FALLBACK_CONCURRENCY=4
# Set to false when the fallback is a local server (Ollama/vLLM) that must not go through OPENAI_PROXY
FALLBACK_USE_PROXY=true

# ---------- local models (CPU) ----------
# Changing CLIP_MODEL/TEXT_MODEL to ones with other dimensions needs a DB migration.
CLIP_MODEL=google/siglip2-base-patch16-256
TEXT_MODEL=intfloat/multilingual-e5-small
CLIP_DIM=768
TEXT_DIM=384
EMBED_THREADS=4
# Empty disables speech transcription
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=4
MAX_VIDEO_FRAMES=5
MAX_GIF_FRAMES=4
# Longest side of images sent for analysis; lower = less Codex usage
ANALYSIS_MAX_SIDE=1280
FRAME_MAX_SIDE=768

# ---------- telegram bot ----------
TELEGRAM_BOT_TOKEN=
# Comma separated Telegram user ids allowed to add memes (send /start to the bot to see yours)
TELEGRAM_ADMIN_IDS=
TELEGRAM_PROXY=
# Optional self-hosted Bot API server (lifts the 20 MB download limit)
TELEGRAM_API_URL=
TELEGRAM_API_LOCAL=false
BOT_MAX_FILE_MB=20
# Inline search (@bot query) for everyone; false = only TELEGRAM_ADMIN_IDS
TELEGRAM_INLINE_PUBLIC=true
# Show memes not yet uploaded to Telegram as links to PUBLIC_URL (needs Telegram to reach your server)
TELEGRAM_INLINE_URL_FALLBACK=false
# Chat the bot uploads memes to once, to reuse their file ids in inline results (private channel id with the bot as admin). Empty = first admin, messages are deleted right away
TELEGRAM_CACHE_CHAT_ID=

# ---------- telegram channel import (public channels via t.me/s/name) ----------
CHANNEL_POLL_MINUTES=30
# Old posts loaded per run while importing a channel's history (runs repeat every minute until done)
CHANNEL_HISTORY_BATCH=300
# Videos longer than this are skipped
CHANNEL_MAX_VIDEO_SECONDS=180
CHANNEL_MAX_FILE_MB=100
# Max differing bits (of 256) for a post to count as an already imported meme
CHANNEL_DEDUP_DISTANCE=12
# Posts with longer text are treated as articles, not memes (0 = off)
CHANNEL_MAX_TEXT_CHARS=700
# Extra comma separated words that mark a post as an ad
CHANNEL_SKIP_WORDS=
# Proxy for t.me web pages and media, falls back to TELEGRAM_PROXY, then OPENAI_PROXY
TELEGRAM_WEB_PROXY=

# ---------- search ----------
# Max image distance for "Looks similar" on the meme page (lower = only near copies of the same template)
LOOKALIKE_MAX_DIST=0.35
